# Copy to your process manager / hosting config. Node does not load .env files by itself.
NODE_ENV=production
PORT=3000
BASE_URL=https://tickets.example.zm
APP_SECRET=change-me-to-64-random-characters
DB_FILE=/var/lib/myticket/myticket.db
UPLOAD_DIR=/var/lib/myticket/uploads
BACKUP_DIR=/var/lib/myticket/backups
BACKUP_KEEP_DAYS=14
# Domain for Caddy (docker compose) and links in SMS
DOMAIN=tickets.example.zm

# MTN MoMo Collection API (sandbox until set)
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=sandbox

# Airtel Money (sandbox until set)
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# SMS via Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# WhatsApp Cloud API
WA_TOKEN=
WA_PHONE_NUMBER_ID=

# Email: POST {to, subject, text}
EMAIL_WEBHOOK_URL=

# USSD and inbound SMS (Africa's Talking format). Register callbacks as /api/ussd?key=<USSD_SECRET> and /api/sms/inbound?key=<USSD_SECRET>
USSD_CODE=*384*123#
USSD_SECRET=change-me
